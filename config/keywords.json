  "excludeRoles": {
    "_note": "按岗位标题/标签剔除整类岗位，命中任一即不进候选表（也不进报告末尾的附录）。2026-10-19 按用户要求剔除 ADAS/智驾方向；2026-11-04 按用户要求剔除 HIL 测试 与 车身域控制器 方向；2026-11-11 按用户要求剔除 总线相关岗位（总线诊断走下方 regex，标题含「总线」的走 terms）。网络测试/车载网络/网络通信/以太网/通讯 用户明确保留，不要再加回来。英文缩写按词边界匹配，避免 ACC 命中 ACCESS 这类误伤。想恢复某个方向，从这里删词即可，不用改代码。",
    "terms": [
      "ADAS", "智能驾驶", "自动驾驶", "智驾", "辅助驾驶", "无人驾驶",
      "舱驾", "自动泊车", "泊车辅助", "泊车", "行车测试", "车道保持", "自适应巡航",
      "AEB", "ACC", "LKA", "APA", "NOA",
      "感知算法", "感知融合", "多传感器融合", "决策规划", "规划控制", "规控",
      "毫米波雷达", "激光雷达",
      "HIL", "硬件在环",
      "总线"
    ],
    "_regexNote": "terms 表达不了「除非」的规则时用 regex。命中 pattern 且不含 unless 才剔除。",
    "regex": [
      {
        "pattern": "车身",
        "unless": "座舱",
        "_why": "车身域控制器方向整体排除。但标题同时含「座舱」的保留 —— 零跑/东软那类「座舱应用测试（仪表、车身控制、HMI）」里车身只是子方向，主体仍是座舱，属于对口岗位。"
      },
      {
        "pattern": "诊断|[Oo][Bb][Dd]",
        "unless": "售后|远程|门店|医疗|病理|影像|医生|健康|B超|产前",
        "_why": "总线诊断方向整体排除（诊断测试、网络诊断、通讯诊断、诊断开发/架构、诊断仪、OBD 等）。售后/远程诊断属于服务工程、医疗诊断与汽车无关，这些保留。"
      }
    ],
    "matchIn": ["title", "tags"]
  },

